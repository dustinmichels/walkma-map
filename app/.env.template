# Copy this file to .env and fill in values as needed.
# For Netlify deployments, set these in the Netlify UI under Site > Environment Variables.

# --- Netlify Function: gsheet ---

# Set to "true" or "1" to disable the live Google Sheet fetch entirely and
# always serve the embedded saved data (netlify/functions/gsheet/data/audits.json).
# Useful if the sheet is unavailable or has changed unexpectedly.
# Note: the function will also fall back to saved data automatically on fetch errors,
# even without this flag.
DISABLE_LIVE_UPDATE=
